{
  "name": "@elsewise/plugin-example-language-server",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "description": "An example plugin that adds TypeScript's language server, typescript-language-server, to the code editor.",
  "scripts": {
    "build": "vite build && elsewise-plugin manifest",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "prettier": "^3.10.0"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.12.4",
    "@elsewise/frontend-plugin": "workspace:*",
    "vscode-languageserver-protocol": "^3.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@elsewise/frontend-plugin": "workspace:*",
    "@elsewise/plugin": "workspace:*",
    "tsserver": "npm:typescript@^6.0.3",
    "typescript": "^7.0.2",
    "typescript-language-server": "6.0.3",
    "vite": "^8.3.8",
    "ws": "^8.22.2"
  }
}
