    "check": "biome check"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@elsewise/plugin": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
