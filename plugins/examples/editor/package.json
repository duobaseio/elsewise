{
  "name": "@elsewise/plugin-example-editor",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "description": "An example plugin that adds to the code editor.",
  "scripts": {
    "build": "vite build",
