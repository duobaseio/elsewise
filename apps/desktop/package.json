{
  "name": "@elsewise/desktop",
  "version": "1.0.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "description": "Electron desktop shell for Elsewise",
  "author": {
    "name": "Duobase"
  },
  "license": "",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @elsewise/web build && tsc -p tsconfig.json --noEmit && node scripts/bundle.mjs && node scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project node",
    "test:electron": "vitest run --project electron",
    "test:all": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "package": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:linux": "pnpm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electron/fuses": "^2.1.3",
    "@elsewise/bridge": "workspace:*",
    "@elsewise/web": "workspace:*",
    "@types/node": "^26.4.1",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  }
}
