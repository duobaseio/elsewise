{
  "name": "@elsewise/daemon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "description": "The Elsewise daemon.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node scripts/build.mjs",
    "generate": "buf generate && tsx scripts/codegen.ts",
    "migration": "cd database && atlas migrate diff --env local",
    "migration:check": "tsx scripts/migration-check.ts",
    "prepare": "pnpm generate",
    "test": "vitest run",
    "test:bundle": "vitest run --config vitest.bundle.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@elsewise/core": "workspace:*",
    "@elsewise/daemon-plugin": "workspace:*",
    "@elsewise/transport": "workspace:*",
    "@lydell/node-pty": "^1.1.0",
    "@parcel/watcher": "^2.6.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "execa": "^10.2.1",
    "kysely": "^0.29.8",
    "which-command": "^0.1.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
