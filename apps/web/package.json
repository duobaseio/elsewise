{
  "name": "@elsewise/web",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "description": "The Elsewise application.",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:visual": "vitest run --project visual",
    "test:visual:update": "vitest run --project visual --update",
    "test:all": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@elsewise/bridge": "workspace:*",
    "@elsewise/components": "workspace:*",
    "@elsewise/plugin": "workspace:*",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.38",
    "dockview-react": "^8.4.0",
    "dompurify": "^3.4.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "es-module-lexer": "^3.0.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "vitest-browser-react": "^2.3.0"
  }
}
