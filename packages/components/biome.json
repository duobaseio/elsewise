{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/src/**/*",
      "**/test/**/*",
      "**/vitest.config.ts",
      "!**/src/styles.css",
      "!**/src/lib/file-icons.gen.ts",
      "!**/src/assets",
      "!**/__screenshots__"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error",
        "useConsistentMemberAccessibility": { "level": "error", "options": { "accessibility": "noPublic" } },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@phosphor-icons/react": "Draw it with <Icon name=\"…\" /> from ./icon, adding a role there if none fits."
            },
            "patterns": [
              {
                "group": ["./**/*.{ts,tsx,js,jsx}", "../**/*.{ts,tsx,js,jsx}"],
                "message": "Import without the extension."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/src/components/icon.tsx", "**/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**/*.{ts,tsx,js,jsx}", "../**/*.{ts,tsx,js,jsx}"],
                    "message": "Import without the extension."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "css": {
    "formatter": {
      "lineWidth": 120
    }
  }
}
