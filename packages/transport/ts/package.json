{
  "name": "@elsewise/transport",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "buf generate && buf generate --template buf.gen.test.yaml",
    "prepare": "pnpm generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
