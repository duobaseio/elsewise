{
  "name": "@elsewise/transport",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "buf generate && buf generate --template buf.gen.test.yaml",
    "prepare": "pnpm generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  }
}
